# EnergiPro Intelligence Platform (Enterprise Demo) — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
# Copy to backend/.env for local use. On Railway, set these as service
# environment variables directly — do not commit a real .env to this repo.
# ═══════════════════════════════════════════════════════════════════════════

# Security — generate a fresh random 48+ char value for every deployment.
# Never reuse this placeholder.
JWT_SECRET_KEY=CHANGE-ME-generate-a-fresh-random-secret-per-deployment
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Admin account (created on first startup only)
ADMIN_EMAIL=admin@energipro.com
# ADMIN_PASSWORD= leave blank for auto-generated temp password (logged once at startup)

# CORS — set to the deployed domain(s) in production
APP_ENV=production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (SQLite file — point at a persistent volume in production)
EIP_DB_PATH=/data/energipro.db

# Security policy
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=10
SESSION_EXPIRE_MINUTES=480

# AI Sales Assistant — leave blank for this public demo. With no key set,
# /api/assistant/ask runs its built-in rule-based fallback (labeled
# "Rule-based" in its response) instead of calling the real Anthropic API.
# This is intentional here — do not set a real key on the public demo deploy.
ANTHROPIC_API_KEY=

# OCR settings (optional)
# OCR_LANG=eng
# OCR_ENABLED=true

# Email delivery for scheduled reports (optional)
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# SMTP_PORT=587

# ── Trial / Licensing ────────────────────────────────────────────────────────
# This public demo is unmanaged/perpetual: leave EIP_LICENSE_ID and
# EIP_LICENSE_CHECK_URL blank (no remote kill-switch) and set EIP_TRIAL_DAYS
# very high so the local expiry never fires. This is NOT how a real client
# trial package should be configured — a real trial sets a genuine
# EIP_LICENSE_ID, a real EIP_LICENSE_CHECK_URL, and EIP_TRIAL_DAYS=14.
EIP_LICENSE_ID=
EIP_LICENSE_CHECK_URL=
EIP_TRIAL_DAYS=36500
